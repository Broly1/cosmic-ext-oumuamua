[Desktop Entry]
Name=App Grid
Comment=Open the frosted-glass application grid, centered or attached to the panel
Type=Application
Exec=cosmic-appgrid-applet
Icon=io.github.broly1.CosmicAppGrid
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Launcher;Applications;Grid;Menu;
NoDisplay=true
StartupNotify=true
X-CosmicApplet=true
X-OverflowPriority=10
